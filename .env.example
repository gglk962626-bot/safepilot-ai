# SafePilot AI 환경변수 예시 파일
# 이 파일을 복사하여 .env 라는 이름으로 저장한 뒤, 실제 API 키를 입력하세요.
# .env 파일은 절대 GitHub에 올리지 마세요 (.gitignore에 이미 제외되어 있습니다).

GEMINI_API_KEY=여기에_발급받은_Gemini_API_키를_입력하세요

# (선택) 사용할 모델 지정 — 미설정 시 기본값 gemini-flash-latest 사용
# 기본 모델이 혼잡(503)할 때는 아래처럼 안정 모델을 지정하세요
# GEMINI_MODEL=gemini-3.5-flash
